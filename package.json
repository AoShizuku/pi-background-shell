{
	"name": "@aoshizuku/pi-background-shell",
	"version": "0.1.1",
	"private": false,
	"type": "module",
	"description": "Background shell tasks for pi: run long commands without blocking, get woken up when they exit",
	"license": "MIT",
	"author": "AoShizuku",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AoShizuku/pi-background-shell.git"
	},
	"homepage": "https://github.com/AoShizuku/pi-background-shell#readme",
	"bugs": {
		"url": "https://github.com/AoShizuku/pi-background-shell/issues"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"background",
		"shell"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"files": [
		"src",
		"!src/**/*.test.ts"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"check": "npm run typecheck && npm run test"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^1.5.0",
		"@earendil-works/pi-tui": "^1.5.0",
		"@types/node": "^22.0.0",
		"typebox": "1.3.27",
		"typescript": "^5.9.0",
		"vitest": "^3.2.4"
	},
	"publishConfig": {
		"access": "public"
	}
}
